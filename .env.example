# Copy this file to .env.local and fill in your own keys.
# .env.local is gitignored - never commit your real keys.

# Free key at https://aistudio.google.com/apikey (image gen needs billing enabled - see README/chat)
VITE_GEMINI_API_KEY=

# Free key at https://auth.pollinations.ai (raises the anonymous rate limit)
VITE_POLLINATIONS_API_KEY=

# Token with the "Inference Providers" permission (fine-grained, NOT a
# generic "Read" token) from https://huggingface.co/settings/tokens -
# used for FLUX.1-schnell image generation. No VITE_ prefix on purpose -
# keep it server-side only, never bundled into client JS.
#   - Local dev: read via process.env in vite.config.js. Put the real
#     value in .env.local only (gitignored) - never in this file.
#   - Live site (Netlify): this file/​.env.local is NOT used at all -
#     set the same variable name and your real token in the Netlify
#     dashboard (Site settings > Environment variables), then redeploy.
#     See netlify/functions/generate-image.js.
HUGGINGFACE_API_TOKEN=
